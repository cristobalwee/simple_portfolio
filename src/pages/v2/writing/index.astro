---
import { getCollection } from "astro:content";
import WorldLayout from "../../../layouts/WorldLayout.astro";
import BackLink from "../../../components/world/BackLink.astro";

const articles = (await getCollection("writing")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<WorldLayout
  title="Writing — Cristobal Graña Samanez"
  description="Thoughts on design, engineering, and craft."
  route="doc"
>
  <article class="doc">
    <div class="doc-nav"><BackLink /></div>

    <header class="doc-head">
      <h1 class="doc-title">Writing</h1>
      <p class="doc-tagline">Notes on design, engineering and craft.</p>
    </header>

    <div class="doc-list">
      {
        articles.map((a) => (
          <a href={`/v2/writing/${a.slug}`}>
            <span>
              <strong>{a.data.title}</strong>
              <small>{a.data.description}</small>
            </span>
            <time datetime={a.data.date}>{fmt(a.data.date)}</time>
          </a>
        ))
      }
    </div>
  </article>
</WorldLayout>
